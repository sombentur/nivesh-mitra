# Nivesh Mitra — optional environment settings.
#
# You normally need NONE of these: every key, account and login the app uses is entered in the app itself
# (first-time setup screen and Settings) and stored encrypted on your PC.
#
# To use this file: copy it to ".env" in the project root (next to the .bat files) and uncomment what you change.
# The backend reads it on start-up. Never commit a real .env (the .gitignore blocks it).

# Where the database, backups and downloaded prices are kept. Default: the "data" folder in the project.
#NM_DATA_DIR=C:\path\to\your\data

# Backend address and port (the web app talks to it; keep it on 127.0.0.1 so nothing else can reach it).
#NM_HOST=127.0.0.1
#NM_PORT=8000

# The address the web app is served from (used for cookies and redirects).
#NM_WEB_ORIGIN=http://localhost:3000

# How long a sign-in lasts, and how long the Google step is valid before the authenticator step.
#NM_SESSION_DAYS=7
#NM_PENDING_LOGIN_MINUTES=10

# Set to false to stop all scheduled jobs (downloads, scoring, backups). Useful for development.
#NM_SCHEDULER_ENABLED=true

# TESTS AND DEVELOPMENT ONLY. Replaces the encryption key from Windows Credential Manager with a fixed one.
# Never set this for normal use: anyone who reads this file could then decrypt your stored keys.
#NM_MASTER_KEY_OVERRIDE=

# Web app only (set in the environment or in web/.env.local, not here): where the backend is.
#NM_BACKEND_URL=http://127.0.0.1:8000
